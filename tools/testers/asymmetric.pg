CREATE or REPLACE FUNCTION compare_dijkstra_one_to_one(fn TEXT, extra_inner_cols TEXT, tbl TEXT, heuristic TEXT)RETURNS SETOF TEXT AS
$BODY$
DECLARE
inner_w_rev_sql TEXT;
inner_no_rev_sql TEXT;
return_cols TEXT;
dijkstra_sql TEXT;
fn_sql TEXT;

BEGIN

  return_cols := 'seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost';
  inner_w_rev_sql := 'SELECT id, source, target, cost, reverse_cost' || extra_inner_cols || ' FROM ' || tbl;
  inner_no_rev_sql := regexp_replace(inner_w_rev_sql, ',\s*reverse_cost', '', 'g');

  FOR i IN 1.. 17  BY 2 LOOP
    FOR j IN 2.. 17 BY 3 LOOP

      -- DIRECTED
      dijkstra_sql := format('SELECT %s FROM %s($$ %s $$, %s , %s, true)', return_cols, 'pgr_dijkstra', inner_w_rev_sql, i , j);
      fn_sql := format('SELECT %s FROM %s($$ %s $$, %s , %s, true %s)', return_cols, fn, inner_w_rev_sql, i , j, heuristic);
      RETURN query SELECT set_eq(fn_sql, dijkstra_sql, fn_sql);

      dijkstra_sql := format('SELECT %s FROM %s($$ %s $$, %s , %s, true)', return_cols, 'pgr_dijkstra', inner_no_rev_sql, i , j);
      fn_sql := format('SELECT %s FROM %s($$ %s $$, %s , %s, true %s)', return_cols, fn, inner_no_rev_sql, i , j, heuristic);
      RETURN query SELECT set_eq(fn_sql, dijkstra_sql, fn_sql);

      -- UNDIRECTED
      dijkstra_sql := format('SELECT %s FROM %s($$ %s $$, %s , %s, false)', return_cols, 'pgr_dijkstra', inner_w_rev_sql, i , j);
      fn_sql := format('SELECT %s FROM %s($$ %s $$, %s , %s, false %s)', return_cols, fn, inner_w_rev_sql, i , j, heuristic);
      RETURN query SELECT set_eq(fn_sql, dijkstra_sql, fn_sql);

      dijkstra_sql := format('SELECT %s FROM %s($$ %s $$, %s , %s, false)', return_cols, 'pgr_dijkstra', inner_no_rev_sql, i , j);
      fn_sql := format('SELECT %s FROM %s($$ %s $$, %s , %s, false %s)', return_cols, fn, inner_no_rev_sql, i , j, heuristic);
      RETURN query SELECT set_eq(fn_sql, dijkstra_sql, fn_sql);

      END LOOP;
  END LOOP;

  RETURN;
END
$BODY$
language plpgsql;

