BEGIN;

SELECT plan(648);

UPDATE edges SET cost = sign(cost) + 0.001 * id * id, reverse_cost = sign(reverse_cost) + 0.001 * id * id;

CREATE TABLE edges_asym AS
SELECT * FROM edges;
UPDATE edges_asym SET cost = cost * 7, reverse_cost = reverse_cost * 2;

CREATE TABLE edges_asym_w_dup_ids AS
SELECT * FROM edges_asym
UNION ALL
SELECT * FROM edges_asym;

CREATE TABLE edges_asym_w_parallels AS
SELECT * FROM edges;
UPDATE edges_asym_w_parallels SET cost = cost * 4, reverse_cost = reverse_cost * 3, id = id * 100;

INSERT INTO edges_asym_w_parallels
SELECT * FROM edges_asym;


CREATE or REPLACE FUNCTION compare_dijkstra(tbl TEXT, lim INTEGER default 17)
RETURNS SETOF TEXT AS
$BODY$
DECLARE
inner_w_rev_sql TEXT;
inner_no_rev_sql TEXT;
dijkstra_sql TEXT;
bdastar_sql TEXT;

BEGIN

    inner_w_rev_sql := 'SELECT * FROM ' || tbl;
    inner_no_rev_sql := 'SELECT id, source, target, cost, x1,y1,x2,y2 FROM ' || tbl;

    FOR i IN 1.. lim  BY 2 LOOP
        FOR j IN 2.. lim BY 3 LOOP

            -- DIRECTED
            dijkstra_sql := 'SELECT seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_dijkstra($$' || inner_w_rev_sql || '$$, ' || i || ', ' || j
                || ', true)';
            bdastar_sql := 'SELECT seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost FROM pgr_bdastar($$' || inner_w_rev_sql || '$$, ' || i || ', ' || j
                || ', true, 0)';
            RETURN query SELECT set_eq(bdastar_sql, dijkstra_sql, bdastar_sql);


            dijkstra_sql := 'SELECT  seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_dijkstra($$' || inner_no_rev_sql || '$$, ' || i || ', ' || j
                || ', true)';
            bdastar_sql := 'SELECT seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost FROM pgr_bdastar($$' || inner_no_rev_sql || '$$, ' || i || ', ' || j
                || ', true, 0)';
            RETURN query SELECT set_eq(bdastar_sql, dijkstra_sql, bdastar_sql);

            -- UNDIRECTED
            dijkstra_sql := 'SELECT seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_dijkstra($$' || inner_w_rev_sql || '$$, ' || i || ', ' || j
                || ', false)';
            bdastar_sql := 'SELECT seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_bdastar($$' || inner_w_rev_sql || '$$, ' || i || ', ' || j
                || ', false, 0)';
            RETURN query SELECT set_eq(bdastar_sql, dijkstra_sql, bdastar_sql);

            dijkstra_sql := 'SELECT seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_dijkstra($$' || inner_no_rev_sql || '$$, ' || i || ', ' || j
                || ', false)';
            bdastar_sql := 'SELECT seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_bdastar($$' || inner_no_rev_sql || '$$, ' || i || ', ' || j
                || ', false, 0)';
            RETURN query SELECT set_eq(bdastar_sql, dijkstra_sql, bdastar_sql);


        END LOOP;
    END LOOP;

    RETURN;
END
$BODY$
language plpgsql;


SELECT * from compare_dijkstra('edges_asym');
SELECT * from compare_dijkstra('edges_asym_w_dup_ids');
SELECT * from compare_dijkstra('edges_asym_w_parallels');

SELECT * FROM finish();
ROLLBACK;

