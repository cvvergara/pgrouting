BEGIN;

SELECT plan(864);

UPDATE edges SET cost = sign(cost) + 0.001 * id * id, reverse_cost = sign(reverse_cost) + 0.001 * id * id;

CREATE or REPLACE FUNCTION bdastarCompareDijkstra(lim INTEGER default 17)
RETURNS SETOF TEXT AS
$BODY$
DECLARE
inner_sql TEXT;
dijkstra_sql TEXT;
bdastar_sql TEXT;
result_columns TEXT;
BEGIN
  IF min_version('3.6.0') THEN

    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges', ',0');
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges_asym', ',0');
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges_asym_w_dup_ids', ',0');
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges_asym_w_parallels', ',0');

  ELSE
    result_columns := ' seq, path_seq, round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost ';

    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges', ',0', result_cols);
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges_asym', ',0', result_cols);
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges_asym_w_dup_ids', ',0', result_cols);
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges_asym_w_parallels', ',0', result_cols);

  END IF;

RETURN;
END
$BODY$
language plpgsql;

SELECT * from bdastarCompareDijkstra();


SELECT * FROM finish();
ROLLBACK;

