BEGIN;

SELECT plan(16);

UPDATE edges SET cost = sign(cost) + 0.001 * id * id, reverse_cost = sign(reverse_cost) + 0.001 * id * id;

CREATE or REPLACE FUNCTION astarcostCompareDijkstra(lim INTEGER default 17)
RETURNS SETOF TEXT AS
$BODY$
BEGIN

  IF min_version('3.6.0') THEN

    RETURN QUERY
    SELECT * from compare_dijkstraCost_many_to_many('pgr_astarcost', ', x1,y1,x2,y2 ', 'edges', ',0');
    RETURN QUERY
    SELECT * from compare_dijkstraCost_many_to_many('pgr_astarcost', ', x1,y1,x2,y2 ', 'edges_asym', ',0');
    RETURN QUERY
    SELECT * from compare_dijkstraCost_many_to_many('pgr_astarcost', ', x1,y1,x2,y2 ', 'edges_asym_w_dup_ids', ',0');
    RETURN QUERY
    SELECT * from compare_dijkstraCost_many_to_many('pgr_astarcost', ', x1,y1,x2,y2 ', 'edges_asym_w_parallels', ',0');

  ELSE

    RETURN QUERY
    SELECT * from compare_dijkstraCost_many_to_many('pgr_astarcost', ', x1,y1,x2,y2 ', 'edges', ',0');
    RETURN QUERY
    SELECT * from compare_dijkstraCost_many_to_many('pgr_astarcost', ', x1,y1,x2,y2 ', 'edges_asym', ',0');
    RETURN QUERY
    SELECT * from compare_dijkstraCost_many_to_many('pgr_astarcost', ', x1,y1,x2,y2 ', 'edges_asym_w_dup_ids', ',0');
    RETURN QUERY
    SELECT * from compare_dijkstraCost_many_to_many('pgr_astarcost', ', x1,y1,x2,y2 ', 'edges_asym_w_parallels', ',0');

END IF;

END
$BODY$
language plpgsql;

SELECT * from astarcostCompareDijkstra();

SELECT * FROM finish();
ROLLBACK;
