BEGIN;

SELECT plan(864);

UPDATE edges SET cost = sign(cost) + 0.001 * id * id, reverse_cost = sign(reverse_cost) + 0.001 * id * id;

CREATE or REPLACE FUNCTION bddijkstraCompareDijkstra(lim INTEGER default 17)
RETURNS SETOF TEXT AS
$BODY$
DECLARE
inner_sql TEXT;
dijkstra_sql TEXT;
bddijkstra_sql TEXT;
result_columns TEXT;
BEGIN

  IF min_version('3.6.0') THEN

    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bddijkstra', ' ', 'edges');
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bddijkstra', ' ', 'edges_asym');
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bddijkstra', ' ', 'edges_asym_w_dup_ids');
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bddijkstra', ' ', 'edges_asym_w_parallels');

  ELSE
    result_columns := ' seq, path_seq, round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost ';

    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bddijkstra', ' ', 'edges', ' ', result_cols);
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bddijkstra', ' ', 'edges_asym', ' ', result_cols);
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bddijkstra', ' ', 'edges_asym_w_dup_ids', ' ', result_cols);
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_one('pgr_bddijkstra', ' ', 'edges_asym_w_parallels', ' ', result_cols);

  END IF;

RETURN;
END
$BODY$
language plpgsql;

SELECT * from bddijkstraCompareDijkstra();


SELECT * FROM finish();
ROLLBACK;

