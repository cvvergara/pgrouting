BEGIN;

SET client_min_messages TO ERROR;

SELECT plan(648);

UPDATE edges SET cost = sign(cost) + 0.001 * id * id, reverse_cost = sign(reverse_cost) + 0.001 * id * id;

CREATE TABLE edges_asym AS
SELECT * FROM edges;
UPDATE edges_asym SET cost = cost * 7, reverse_cost = reverse_cost * 2;

CREATE TABLE edges_asym_w_dup_ids AS
SELECT * FROM edges_asym
UNION ALL
SELECT * FROM edges_asym;

CREATE TABLE edges_asym_w_parallels AS
SELECT * FROM edges;
UPDATE edges_asym_w_parallels SET cost = cost * 4, reverse_cost = reverse_cost * 3, id = id * 100;

INSERT INTO edges_asym_w_parallels
SELECT * FROM edges_asym;



CREATE or REPLACE FUNCTION bddijkstra_compare_dijkstra(tbl TEXT, lim INTEGER default 17)
RETURNS SETOF TEXT AS
$BODY$
DECLARE
inner_w_rev_sql TEXT;
inner_no_rev_sql TEXT;
dijkstra_sql TEXT;
bddijkstra_sql TEXT;
BEGIN

    FOR i IN 1.. lim  BY 2 LOOP
        FOR j IN 2.. lim BY 3 LOOP

            -- DIRECTED
            inner_w_rev_sql := 'SELECT * FROM ' || tbl;
            inner_no_rev_sql := 'SELECT id, source, target, cost FROM ' || tbl;
            dijkstra_sql := 'SELECT seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_dijkstra($$' || inner_w_rev_sql || '$$, ' || i || ', ' || j
                || ', true)';

            bddijkstra_sql := 'SELECT seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_bddijkstra($$' || inner_w_rev_sql || '$$, ' || i || ', ' || j
                || ', true)';
            RETURN query SELECT set_eq(bddijkstra_sql, dijkstra_sql, bddijkstra_sql);


            dijkstra_sql := 'SELECT  seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_dijkstra($$' || inner_no_rev_sql || '$$, ' || i || ', ' || j
                || ', true)';
            bddijkstra_sql := 'SELECT  seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_bddijkstra($$' || inner_no_rev_sql || '$$, ' || i || ', ' || j
                || ', true)';
            RETURN query SELECT set_eq(bddijkstra_sql, dijkstra_sql, bddijkstra_sql);

            -- UNDIRECTED
            dijkstra_sql := 'SELECT  seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_dijkstra($$' || inner_w_rev_sql || '$$, ' || i || ', ' || j
                || ', false)';
            bddijkstra_sql := 'SELECT  seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_bddijkstra($$' || inner_w_rev_sql || '$$, ' || i || ', ' || j
                || ', false)';
            RETURN query SELECT set_eq(bddijkstra_sql, dijkstra_sql, bddijkstra_sql);


            dijkstra_sql := 'SELECT  seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_dijkstra($$' || inner_no_rev_sql || '$$, ' || i || ', ' || j
                || ', false)';
            bddijkstra_sql := 'SELECT  seq,node,edge,round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost  FROM pgr_bddijkstra($$' || inner_no_rev_sql || '$$, ' || i || ', ' || j
                || ', false)';
            RETURN query SELECT set_eq(bddijkstra_sql, dijkstra_sql, bddijkstra_sql);


        END LOOP;
    END LOOP;

    RETURN;
END
$BODY$
language plpgsql;


SELECT * from bddijkstra_compare_dijkstra('edges_asym');
SELECT * from bddijkstra_compare_dijkstra('edges_asym_w_dup_ids');
SELECT * from bddijkstra_compare_dijkstra('edges_asym_w_parallels');

SELECT * FROM finish();
ROLLBACK;

