BEGIN;

  SELECT CASE WHEN  min_version('3.6.0') AND min_lib_version('4.0.3') THEN plan(144) ELSE plan(36) END;

UPDATE edges SET cost = sign(cost) + 0.001 * id * id, reverse_cost = sign(reverse_cost) + 0.001 * id * id;

CREATE or REPLACE FUNCTION CompareDijkstra()
RETURNS SETOF TEXT AS
$BODY$
DECLARE
result_columns TEXT;

BEGIN

  IF min_lib_version('4.0.3') THEN

    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_many('pgr_bddijkstra', ' ', 'edges');
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_many('pgr_bddijkstra', ' ', 'edges_asym');
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_many('pgr_bddijkstra', ' ', 'edges_asym_w_dup_ids');
    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_many('pgr_bddijkstra', ' ', 'edges_asym_w_parallels');

  ELSIF min_version('3.6.0') THEN

    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_many('pgr_bddijkstra', ' ', 'edges');

  ELSE

    result_columns := ' seq, path_seq, end_vid, round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost ';

    RETURN QUERY
    SELECT * from compare_dijkstra_one_to_many('pgr_bddijkstra', ' ', 'edges', result_columns);

  END IF;

END
$BODY$
language plpgsql;

SELECT * from CompareDijkstra();

SELECT * FROM finish();
ROLLBACK;
