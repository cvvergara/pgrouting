BEGIN;

SELECT CASE WHEN min_lib_version('4.0.3') THEN plan(864) ELSE plan(216) END;

UPDATE edges SET cost = sign(cost) + 0.001 * id * id, reverse_cost = sign(reverse_cost) + 0.001 * id * id;

CREATE or REPLACE FUNCTION astarCostCompareDijkstra()
RETURNS SETOF TEXT AS
$BODY$

BEGIN

  IF min_lib_version('4.0.3') THEN

    RETURN QUERY
    SELECT * from compare_dijkstraCost_one_to_one('pgr_bddijkstraCost', ' ', 'edges');
    RETURN QUERY
    SELECT * from compare_dijkstraCost_one_to_one('pgr_bddijkstraCost', ' ', 'edges_asym');
    RETURN QUERY
    SELECT * from compare_dijkstraCost_one_to_one('pgr_bddijkstraCost', ' ', 'edges_asym_w_dup_ids');
    RETURN QUERY
    SELECT * from compare_dijkstraCost_one_to_one('pgr_bddijkstraCost', ' ', 'edges_asym_w_parallels');

  ELSE

    RETURN QUERY
    SELECT * from compare_dijkstraCost_one_to_one('pgr_bddijkstraCost', ' ', 'edges');

  END IF;

END
$BODY$
language plpgsql;

SELECT * from astarCostCompareDijkstra();

SELECT * FROM finish();
ROLLBACK;
