BEGIN;

/* Parallel edges in pgr_ksp.
 *
 * A loopless path is identified by the vertices it goes through, but when a
 * (source, target) pair carries several parallel edges each of them takes the
 * path through those same vertices at a different cost, so each one is a path
 * of its own and pgr_ksp reports all of them.
 *
 * The graph below carries three parallel edges 1 -> 2 with costs 1, 2 and 3,
 * plus an alternate route 1 -> 3 -> 4 -> 2 costing 15, so there are exactly
 * four loopless paths 1 -> 2:
 *
 *     1 -> 2                     over edge 1  = 1
 *     1 -> 2                     over edge 2  = 2
 *     1 -> 2                     over edge 3  = 3
 *     1 -> 3 -> 4 -> 2           over 4,5,6   = 15
 *
 * They come out cheapest first: k=1 reports the first, k=2 the two cheapest,
 * k=3 the three parallel hops and k=4 adds the alternate route, after which k=5
 * and above repeat the same four paths however large k gets. */

CREATE TEMP TABLE par AS
SELECT * FROM (VALUES
       (1, 1, 2, 1, -1),
       (2, 1, 2, 2, -1),
       (3, 1, 2, 3, -1),
       (4, 1, 3, 4, -1),
       (5, 3, 4, 5, -1),
       (6, 4, 2, 6, -1))
AS t(id, source, target, cost, reverse_cost);

/* The same graph with two of the three parallel edges removed, leaving only the
 * cheapest of the bundle: without them the two extra paths are gone and only
 * the direct hop and the alternate route are left. */
CREATE TEMP TABLE par_single AS
SELECT * FROM (VALUES
       (1, 1, 2, 1, -1),
       (4, 1, 3, 4, -1),
       (5, 3, 4, 5, -1),
       (6, 4, 2, 6, -1))
AS t(id, source, target, cost, reverse_cost);

SELECT plan(8);

/* the cheapest path only, over edge 1 */
PREPARE r_one AS
SELECT * FROM (VALUES
       (1, 1, 1,  1,  0::numeric),
       (1, 2, 2, -1,  1::numeric))
AS t(path_id, path_seq, node, edge, agg_cost);

/* the cheapest and the second cheapest, two direct hops over different edges */
PREPARE r_two AS
SELECT * FROM (VALUES
       (1, 1, 1,  1,  0::numeric),
       (1, 2, 2, -1,  1::numeric),
       (2, 1, 1,  2,  0::numeric),
       (2, 2, 2, -1,  2::numeric))
AS t(path_id, path_seq, node, edge, agg_cost);

/* one direct hop per parallel edge */
PREPARE r_three AS
SELECT * FROM (VALUES
       (1, 1, 1,  1,  0::numeric),
       (1, 2, 2, -1,  1::numeric),
       (2, 1, 1,  2,  0::numeric),
       (2, 2, 2, -1,  2::numeric),
       (3, 1, 1,  3,  0::numeric),
       (3, 2, 2, -1,  3::numeric))
AS t(path_id, path_seq, node, edge, agg_cost);

/* every loopless path of the graph */
PREPARE r_four AS
SELECT * FROM (VALUES
       (1, 1, 1,  1,  0::numeric),
       (1, 2, 2, -1,  1::numeric),
       (2, 1, 1,  2,  0::numeric),
       (2, 2, 2, -1,  2::numeric),
       (3, 1, 1,  3,  0::numeric),
       (3, 2, 2, -1,  3::numeric),
       (4, 1, 1,  4,  0::numeric),
       (4, 2, 3,  5,  4::numeric),
       (4, 3, 4,  6,  9::numeric),
       (4, 4, 2, -1, 15::numeric))
AS t(path_id, path_seq, node, edge, agg_cost);

PREPARE q1 AS
SELECT path_id, path_seq, node, edge, agg_cost::numeric AS agg_cost
FROM pgr_ksp('SELECT id, source, target, cost, reverse_cost FROM par',
             1, 2, 1, directed:=true);
SELECT set_eq('q1', 'r_one', 'k=1 gives the cheapest path, over the cheapest edge 1');

PREPARE q2 AS
SELECT path_id, path_seq, node, edge, agg_cost::numeric AS agg_cost
FROM pgr_ksp('SELECT id, source, target, cost, reverse_cost FROM par',
             1, 2, 2, directed:=true);
SELECT set_eq('q2', 'r_two', 'k=2 adds the second parallel edge as a path of its own');

PREPARE q3 AS
SELECT path_id, path_seq, node, edge, agg_cost::numeric AS agg_cost
FROM pgr_ksp('SELECT id, source, target, cost, reverse_cost FROM par',
             1, 2, 3, directed:=true);
SELECT set_eq('q3', 'r_three', 'k=3 reports the whole bundle, one path per parallel edge');

PREPARE q4 AS
SELECT path_id, path_seq, node, edge, agg_cost::numeric AS agg_cost
FROM pgr_ksp('SELECT id, source, target, cost, reverse_cost FROM par',
             1, 2, 4, directed:=true);
SELECT set_eq('q4', 'r_four', 'k=4 adds the alternate route, all the loopless paths are reported');

PREPARE q5 AS
SELECT path_id, path_seq, node, edge, agg_cost::numeric AS agg_cost
FROM pgr_ksp('SELECT id, source, target, cost, reverse_cost FROM par',
             1, 2, 100, directed:=true);
SELECT set_eq('q5', 'r_four', 'k=100 repeats the same four paths');

PREPARE q6 AS
SELECT path_id, path_seq, node, edge, agg_cost::numeric AS agg_cost
FROM pgr_ksp('SELECT id, source, target, cost, reverse_cost FROM par',
             1, 2, 100, directed:=false);
SELECT set_eq('q6', 'r_four', 'undirected gives the same four paths');

/* the path k=1 reports goes over the cheapest edge of the bundle, worked out
 * from the data rather than hardcoded, so the test states the contract instead
 * of one particular fixture */
PREPARE q_cheapest AS
SELECT DISTINCT edge
FROM pgr_ksp('SELECT id, source, target, cost, reverse_cost FROM par',
             1, 2, 1, directed:=true)
WHERE path_seq = 1;

PREPARE r_cheapest AS
SELECT id::bigint AS edge
FROM par
WHERE source = 1 AND target = 2
ORDER BY cost, id
LIMIT 1;

SELECT set_eq('q_cheapest', 'r_cheapest',
    'the cheapest path uses the cheapest of the parallel edges');

/* dropping the two extra edges of the bundle drops the two paths they carry,
 * the direct hop and the alternate route are untouched */
PREPARE q_single AS
SELECT path_id, path_seq, node, edge, agg_cost::numeric AS agg_cost
FROM pgr_ksp('SELECT id, source, target, cost, reverse_cost FROM par_single',
             1, 2, 100, directed:=true);

PREPARE r_single AS
SELECT * FROM (VALUES
       (1, 1, 1,  1,  0::numeric),
       (1, 2, 2, -1,  1::numeric),
       (2, 1, 1,  4,  0::numeric),
       (2, 2, 3,  5,  4::numeric),
       (2, 3, 4,  6,  9::numeric),
       (2, 4, 2, -1, 15::numeric))
AS t(path_id, path_seq, node, edge, agg_cost);

SELECT set_eq('q_single', 'r_single',
    'without the two extra parallel edges only two paths are reported');

SELECT finish();
ROLLBACK;
