BEGIN;

SELECT CASE WHEN min_version('4.1.0') THEN plan(7) WHEN min_version('3.4.0') THEN plan(5) ELSE plan(1) END;

CREATE OR REPLACE FUNCTION types_check_deprecated()
RETURNS SETOF TEXT AS
$BODY$
BEGIN

  IF NOT min_version('3.4.0') THEN
    RETURN QUERY
    SELECT skip(1, 'Function is new on 3.4.0');
    RETURN;
  END IF;

RETURN QUERY
SELECT has_function('pgr_hawickcircuits');
RETURN QUERY
SELECT has_function('pgr_hawickcircuits', ARRAY['text']);
RETURN QUERY
SELECT function_returns('pgr_hawickcircuits', ARRAY['text'],'setof record');

RETURN QUERY
SELECT function_args_eq('pgr_hawickcircuits',
  $$VALUES
  ('{"","seq","path_id","depth","start_vid","end_vid","pred","node","edge","cost","agg_cost"}'::TEXT[])
  $$);

RETURN QUERY
SELECT function_types_eq('pgr_hawickcircuits',
  $$VALUES
  ('{text,int4,int4,int4,int8,int8,int8,int8,int8,float8,float8}'::TEXT[])
  $$);

END;
$BODY$
LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION types_check()
RETURNS SETOF TEXT AS
$BODY$
BEGIN

  IF NOT min_version('4.1.0') THEN
    RETURN QUERY
    SELECT types_check_deprecated();
    RETURN;
  END IF;

RETURN QUERY
SELECT has_function('pgr_hawickcircuits');
RETURN QUERY
SELECT has_function('pgr_hawickcircuits', '{text,int8,_int8,int8,bool}'::TEXT[]);
RETURN QUERY
SELECT function_returns('pgr_hawickcircuits', '{text,int8,_int8,int8,bool}'::TEXT[],'setof record');

RETURN QUERY
SELECT collect_tap(

  has_function('pgr_hawickcircuits', ARRAY['text']),

  function_returns('pgr_hawickcircuits', ARRAY['text'],'setof record'),

  function_args_eq('pgr_hawickcircuits',
    $$VALUES
    ('{"","seq","path_id","depth","start_vid","end_vid","pred","node","edge","cost","agg_cost"}'::TEXT[]),
    ('{"",min_depth,start_ids,max_depth,self_loops,seq,path_id,depth,start_vid,end_vid,pred,node,edge,cost,agg_cost}'::TEXT[])
    $$),

  function_types_eq('pgr_hawickcircuits',
    $$VALUES
    ('{text,int4,int4,int4,int8,int8,int8,int8,int8,float8,float8}'::TEXT[]),
    ('{text,int8,_int8,int8,bool,int4,int4,int4,int8,int8,int8,int8,int8,float8,float8}'::TEXT[])
    $$)
);

END;
$BODY$
LANGUAGE plpgsql;


SELECT types_check();

SELECT * FROM finish();
ROLLBACK;

