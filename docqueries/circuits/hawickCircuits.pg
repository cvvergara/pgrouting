/* -- q1 */
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM edges'
);
/* -- q2 */
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM edges', 10
);
/* -- q3 */
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM edges', ARRAY[10,11]
);
/* -- q4 */
SELECT id, source, target, cost, reverse_cost
INTO c_example
FROM edges
WHERE id IN (4, 7, 8, 10, 11, 12) ORDER BY id;
INSERT INTO c_example (id, source, target, cost, reverse_cost)
VALUES
    (100, 7, 7, 1, 1), (101, 7, 20 , 1, -1), (102, 20, 21, 1, -1) , (103, 21, 7, 1,-1), (104, 7,8, 1.5, 1.7);
/* -- q5 */
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM c_example', 0, 0
);
/* -- q6 */
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM c_example'
);
/* -- q7 */
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM c_example', 0,
    self_loops => false
);
/* -- q7 */
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM c_example', 0, 1, 1
);
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM c_example', 0, 1, 2
);
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM c_example', 0, 1, 3
);
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM c_example', 0, 3, 3
);
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM c_example', 7
);
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM c_example', 7,
    self_loops => false
);
/* -- q8 */
SELECT * FROM pgr_hawickCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM c_example',
    ARRAY[10,11], min_depth => 3, max_depth => 6
);
/* -- q9 */
