/* -- q1 */
SELECT * FROM pgr_hawickUniqueCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM edges'
);
 seq | path_id | depth | start_vid | end_vid | pred | node | edge | cost | agg_cost
-----+---------+-------+-----------+---------+------+------+------+------+----------
(0 rows)

/* -- q2 */
SELECT * FROM pgr_hawickUniqueCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM edges', 10
);
 seq | path_id | depth | start_vid | end_vid | pred | node | edge | cost | agg_cost
-----+---------+-------+-----------+---------+------+------+------+------+----------
(0 rows)

/* -- q3 */
SELECT * FROM pgr_hawickUniqueCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM edges', ARRAY[10,11]
);
 seq | path_id | depth | start_vid | end_vid | pred | node | edge | cost | agg_cost
-----+---------+-------+-----------+---------+------+------+------+------+----------
(0 rows)

/* -- q4 */
SELECT id, source, target, cost, reverse_cost
INTO c_example
FROM edges
WHERE id IN (4, 7, 8, 10, 11, 12) ORDER BY id;
SELECT 6
INSERT INTO c_example (id, source, target, cost, reverse_cost)
VALUES
    (100, 7, 7, 1, 1), (101, 7, 20 , 1, -1), (102, 20, 21, 1, -1) , (103, 21, 7, 1,-1), (104, 7,8, 1.5, 1.5);
INSERT 0 5
/* -- q5 */
SELECT * FROM pgr_hawickUniqueCircuits(
    'SELECT id, source, target, cost, reverse_cost FROM c_example', 0, 0
);
 seq | path_id | depth | start_vid | end_vid | pred | node | edge | cost | agg_cost
-----+---------+-------+-----------+---------+------+------+------+------+----------
   1 |       1 |     0 |         7 |       7 |    7 |    7 |  100 |    1 |        0
   2 |       1 |     1 |         7 |       7 |    7 |    7 |   -1 |    0 |        1
   3 |       2 |     0 |         7 |       7 |    7 |    7 |  103 |    1 |        0
   4 |       2 |     1 |         7 |       7 |    7 |   21 |  102 |    1 |        1
   5 |       2 |     2 |         7 |       7 |   21 |   20 |  101 |    1 |        2
   6 |       2 |     3 |         7 |       7 |    7 |    7 |   -1 |    0 |        3
(6 rows)

