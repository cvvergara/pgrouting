/* -- q4 */
CREATE TABLE c_example (
  id BIGINT,
  source BIGINT,
  target BIGINT,
  cost FLOAT,
  reverse_cost FLOAT
);
CREATE TABLE
INSERT INTO c_example (id, source, target, cost, reverse_cost) VALUES
(1, 1, 2, 1,  1),
(2, 2, 3, 1,  1),
(3, 1, 3, 1, 1),
(4, 1, 3, 1.5, 1.7),
(5, 1, 4, 1,  1),
(6, 1, 5, 1, -1),
(7, 1, 1, 1, -1);
INSERT 0 7
